# Copy this file to .env and fill in your Supabase project values.
# Do not commit .env or any private provider/API keys.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Generate with: openssl rand -hex 32. Keep stable; changing it invalidates saved connector tokens.
CONNECTOR_ENCRYPTION_KEY=

# Optional Hermes Agent service (separate Hermes Agent API server).
# Set the server origin only, e.g. http://127.0.0.1:8642 (do not append /v1).
HERMES_BASE_URL=
# Set this only if your Hermes API server requires a bearer token.
HERMES_API_KEY=
# Must match a model exposed by your Hermes API server; default: hermes-agent.
HERMES_MODEL=hermes-agent
