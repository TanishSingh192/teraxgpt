# Copy this file to .env and fill in your Supabase project values.
# Do not commit .env or any private provider/API keys.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Generate with: openssl rand -hex 32. Keep stable; changing it invalidates saved connector tokens.
CONNECTOR_ENCRYPTION_KEY=

# OpenRouter API key for PowerPoint generation. Server-side secret only; never use a VITE_ prefix.
OPENROUTER_API_KEY=
# Optional OpenRouter model override for slide generation. Default: google/gemini-2.5-flash
OPENROUTER_PRESENTATION_MODEL=google/gemini-2.5-flash

# Google Gemini API key for Gemini-backed chat/voice features that still use Google directly. Server-side secret only; never use a VITE_ prefix.
GEMINI_API_KEY=

# Optional Agno AgentOS service (see services/agno-agent/README.md).
# AgentOS origin, e.g. http://agno-agent:7777 on a private container network.
AGNO_BASE_URL=
# Shared secret: must match AGNO_AGENTOS_API_KEY on the Agno service.
AGNO_API_KEY=
# Agent ID registered by the service; defaults to teraxgpt-assistant.
AGNO_AGENT_ID=teraxgpt-assistant
